# vocaloid_radar — environment template. Copy to `.env` (gitignored) and fill in.
# No real values live in git; only this template with placeholders does.

# Dev Postgres (docker-compose.dev.yml provides this locally).
DATABASE_URL=postgresql://vocaloid:vocaloid@localhost:5433/vocaloid

# llm_gateway (OpenAI-compatible LiteLLM proxy). The real address is a private
# host — set it here, never commit it. Localhost is the default for running the
# gateway's own docker-compose alongside this project.
GATEWAY_URL=http://localhost:4000
GATEWAY_API_KEY=
